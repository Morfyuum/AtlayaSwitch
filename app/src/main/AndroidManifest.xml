<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AtlayaSwitch"
        android:localeConfig="@xml/locales_config"
        android:exported="false">

        <!-- Startet den Wechsel beim Antippen des App-Icons -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AtlayaSwitch.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Einstellungen: Zielprofil wählen. Direkt startbar UND über
             die "App-Info"-Seite der Systemeinstellungen erreichbar
             (ACTION_APPLICATION_PREFERENCES zeigt dort automatisch einen
             "Einstellungen"-Link an), damit kein eigenes auffälliges Menü nötig ist. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Schnelleinstellungen-Kachel, Ersatz fuer den entfernten NFC-Trigger (siehe
             interne Projekt-Doku und QuickSwitchTileService) - Label/Icon bewusst neutral gehalten. -->
        <service
            android:name=".QuickSwitchTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Erforderlich für die Kommunikation mit dem Shizuku-Dienst -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.capecter.atlayaswitch.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true" />

    </application>
</manifest>
